# ==========================================
# Korean in Real Life — 환경 변수 템플릿
# 이 파일을 .env.local로 복사 후 값 채우기
# $ cp .env.local.example .env.local
# ==========================================

# Supabase
# https://supabase.com/dashboard → 프로젝트 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (서버 사이드 전용 — 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret
# $ stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Products → Prices에서 확인)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# App URL (Vercel 배포 시 자동으로 설정됨)
NEXT_PUBLIC_APP_URL=http://localhost:3000
