# ==========================================
# Korean in Real Life — 환경 변수 템플릿
# 이 파일을 .env.local로 복사 후 값 채우기
# $ cp .env.example .env.local
# ==========================================

# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud TTS (Phase 2 — 선택)
# https://console.cloud.google.com → Cloud Text-to-Speech API → 사용 설정 → API 키 생성
# 없으면 Web Speech API (브라우저 내장)로 자동 fallback
GOOGLE_TTS_API_KEY=your-google-cloud-api-key-here

# ── K-pop concerts (/concerts) ──
# Affiliate tracking-link templates, set after each program approves you.
# {url} is replaced by the URL-encoded destination. Leave empty for plain links.
NEXT_PUBLIC_AFFILIATE_TICKETMASTER=
NEXT_PUBLIC_AFFILIATE_SEATGEEK=
NEXT_PUBLIC_AFFILIATE_KLOOK=
# Hotel links: extra query parameters, e.g. "aid=123", "cid=123", "Allianceid=123&SID=456"
NEXT_PUBLIC_AFFILIATE_BOOKING_PARAMS=
NEXT_PUBLIC_AFFILIATE_AGODA_PARAMS=
NEXT_PUBLIC_AFFILIATE_TRIPCOM_PARAMS=
# For `npm run concerts:extract` (or sign in with `ant auth login`)
ANTHROPIC_API_KEY=
