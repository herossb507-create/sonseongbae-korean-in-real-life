// Cloudflare Workers static assets: serves the `out/` folder from `npm run build`.
// A tiny Worker (cloudflare/worker.js) handles only the paths in run_worker_first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "korean-in-real-life",
  "compatibility_date": "2026-10-01",
  "main": "cloudflare/worker.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /concerts → concerts.html, /concerts/artists/bts → concerts/artists/bts.html
    "html_handling": "auto-trailing-slash",
    // Unknown paths get out/404.html with a 404 status
    "not_found_handling": "404-page",
    // Google Search Console verification file (must not be redirected)
    "run_worker_first": ["/google76f349ea99c14637.html"]
  }
}
