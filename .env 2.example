# ==========================================
# Korean in Real Life — 환경 변수 템플릿
# 이 파일을 .env.local로 복사 후 값 채우기
# $ cp .env.local.example .env.local
# ==========================================

# Supabase
# https://supabase.com/dashboard → 프로젝트 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (서버 사이드 전용 — 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Lemon Squeezy
# https://app.lemonsqueezy.com → Settings → API
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...

# Store ID: https://app.lemonsqueezy.com → Settings → Stores
LEMONSQUEEZY_STORE_ID=12345

# Variant IDs: Products → 상품 선택 → Variants에서 확인
LEMONSQUEEZY_VARIANT_MONTHLY=111111
LEMONSQUEEZY_VARIANT_ANNUAL=222222

# Webhook Signing Secret: Webhooks → 웹훅 생성 후 표시되는 Signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# App URL (Vercel 배포 시 자동으로 설정됨)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud TTS (Phase 2 — 선택)
# https://console.cloud.google.com → Cloud Text-to-Speech API → 사용 설정 → API 키 생성
# 없으면 Web Speech API (브라우저 내장)로 자동 fallback
GOOGLE_TTS_API_KEY=your-google-cloud-api-key-here
